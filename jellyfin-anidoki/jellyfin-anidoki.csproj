<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>jellyfin_anidoki</RootNamespace>
        <Version>0.1.0.0</Version>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <FileVersion>0.1.0.0</FileVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputPath>bin\Debug/</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>bin\Release/</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
        <PackageReference Include="Jellyfin.Model" Version="12.2.0" />
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
        <PackageReference Include="System.Collections" Version="4.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Configuration\NotificationsJs.js"/>
        <EmbeddedResource Include="Configuration\NotificationsJs.js"/>
        <None Remove="Configuration\NotificationStateJs.js"/>
        <EmbeddedResource Include="Configuration\NotificationStateJs.js"/>
        <None Remove="Configuration\Anidoki.css"/>
        <EmbeddedResource Include="Configuration\Anidoki.css"/>
        <None Remove="Configuration\ConfigStateJs.js"/>
        <EmbeddedResource Include="Configuration\ConfigStateJs.js"/>
        <None Remove="Configuration\ConfigPageUserJs.js"/>
        <EmbeddedResource Include="Configuration\ConfigPageUserJs.js"/>
        <None Remove="Configuration\ConfigPage.html"/>
        <EmbeddedResource Include="Configuration\ConfigPage.html"/>
        <None Remove="Configuration\ConfigPageJs.js"/>
        <EmbeddedResource Include="Configuration\ConfigPageJs.js"/>
        <None Remove="Configuration\ConfigPageUser.html"/>
        <EmbeddedResource Include="Configuration\ConfigPageUser.html"/>
        <None Remove="Configuration\CommonJs.js"/>
        <EmbeddedResource Include="Configuration\CommonJs.js"/>
        <None Remove="Configuration\ManualSync.html"/>
        <EmbeddedResource Include="Configuration\ManualSync.html"/>
        <None Remove="Configuration\ManualSyncJs.js"/>
        <EmbeddedResource Include="Configuration\ManualSyncJs.js"/>
        <None Remove="Configuration\Images\provider-anilist.svg"/>
        <EmbeddedResource Include="Configuration\Images\provider-anilist.svg" LogicalName="jellyfin_anidoki.Configuration.Images.provider-anilist.svg"/>
        <None Remove="Configuration\Images\provider-mal.svg"/>
        <EmbeddedResource Include="Configuration\Images\provider-mal.svg" LogicalName="jellyfin_anidoki.Configuration.Images.provider-mal.svg"/>
        <None Remove="Configuration\Images\provider-kitsu.svg"/>
        <EmbeddedResource Include="Configuration\Images\provider-kitsu.svg" LogicalName="jellyfin_anidoki.Configuration.Images.provider-kitsu.svg"/>
        <None Remove="Configuration\Images\provider-annict.png"/>
        <EmbeddedResource Include="Configuration\Images\provider-annict.png" LogicalName="jellyfin_anidoki.Configuration.Images.provider-annict.png"/>
        <None Remove="Configuration\Images\provider-shikimori.svg"/>
        <EmbeddedResource Include="Configuration\Images\provider-shikimori.svg" LogicalName="jellyfin_anidoki.Configuration.Images.provider-shikimori.svg"/>
        <None Remove="Configuration\Images\provider-simkl.svg"/>
        <EmbeddedResource Include="Configuration\Images\provider-simkl.svg" LogicalName="jellyfin_anidoki.Configuration.Images.provider-simkl.svg"/>
        <EmbeddedResource Include="Configuration\Images\PROVIDER-ASSETS.md" LogicalName="jellyfin_anidoki.Configuration.Images.PROVIDER-ASSETS.md"/>
        <EmbeddedResource Include="Configuration\Images\LICENSE-Simple-Icons.txt" LogicalName="jellyfin_anidoki.Configuration.Images.LICENSE-Simple-Icons.txt"/>
        <EmbeddedResource Include="Configuration\Images\LICENSE-Annict.txt" LogicalName="jellyfin_anidoki.Configuration.Images.LICENSE-Annict.txt"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="builds\**"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>jellyfin-anidoki-unit-tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>


</Project>

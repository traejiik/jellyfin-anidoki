<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>jellyfin_anidoki</RootNamespace>
        <Nullable>enable</Nullable>
        <!-- Every warning fails the build, nullable ones included; see CONTRIBUTING.md. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Version>0.0.0.0</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <FileVersion>0.0.0.0</FileVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputPath>bin\Debug/</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>bin\Release/</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- Only for the File Transformation plugin interop (NotificationWebIntegration). -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
        <PackageReference Include="Jellyfin.Model" Version="12.4.0" />
        <PackageReference Include="Serilog" Version="4.3.0" ExcludeAssets="runtime" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" ExcludeAssets="runtime" />
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <!-- Jellyfin 12.4 ships this assembly and native SQLite; the plugin folder must not carry its own copy. -->
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Web\NotificationsJs.js"/>
        <EmbeddedResource Include="Web\NotificationsJs.js"/>
        <None Remove="Web\DiscordSettingsJs.js"/>
        <EmbeddedResource Include="Web\DiscordSettingsJs.js"/>
        <None Remove="Web\Images\branding\anidoki-avatar.png"/>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>jellyfin_anidoki_unit_tests</RootNamespace>
        <Nullable>enable</Nullable>
        <!-- Nullable warnings fail the build; see CONTRIBUTING.md. -->
        <WarningsAsErrors>nullable</WarningsAsErrors>

        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <!-- Tests run outside Jellyfin, so they need SQLite's runtime and native library themselves. -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <PackageReference Include="Moq.Contrib.HttpClient" Version="1.4.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
        <!-- The version Jellyfin ships, so the API-docs test builds the document the way the server does. -->
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\jellyfin-anidoki\jellyfin-anidoki.csproj" />
    </ItemGroup>

</Project>
